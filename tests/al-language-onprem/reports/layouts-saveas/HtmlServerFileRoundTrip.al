// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/methods-auto/report/report-saveas-method
// Scope: in-scope, but ONLY for a Target = OnPrem app (File, Exists, Erase and the server file procedures of File Management are Scope = OnPrem)
// Fixtures used: Probe Observer (69160); File Management (Base Application), Temp Blob and Base64 Convert (System Application); own table
//   98030, report 98031 (LtHsfWord.docx, generated by alc /generatereportlayout for its dataset), test codeunit 98032.
// Probe: the round trip of the Base Application's #if not CLEAN27 code in Report Selections (GetEmailBodyForVend, GetEmailBodyTextForCust,
//   DoSaveReportAsHTMLInTempBlob): a Word layout report saved as Html (and Pdf) into a Temp Blob, written to a server file
//   (TempBlobToServerFile, an internal procedure, done here as it does it: CreateInStream with UTF8, then InstreamExportToServerFile; or
//   ServerTempFileName plus BLOBExportToServerFile), read back with BLOBImportFromServerFile after Clear(TempBlob), then DeleteServerFile.
//   The same chain by hand with File (CreateTempFile, WriteMode, Create, CreateOutStream, CopyStream, Open, CreateInStream, Erase).
// Facts asked, never the bytes or the path themselves: the SaveAs answer; HasValue before and after Clear and after the import; whether the
//   file exists after the export and after the delete; the DeleteServerFile answer (also for a path that does not exist and a second call);
//   whether the imported blob is byte-identical (Length and Base64 text) to a direct CopyStream copy taken right after SaveAs; whether
//   InStream.Read(Text) of both blobs gives the same text; the export from an InStream without TextEncoding::UTF8.
// BC versions: 27 - 29

table 98030 "LT HSF Row"
{
    DataClassification = SystemMetadata;

    fields
    {
        field(1; Id; Integer) { }
        field(2; Txt; Text[30]) { }
    }

    keys
    {
        key(PK; Id) { Clustered = true; }
    }
}

report 98031 "LT HSF Word Rpt"
{
    UsageCategory = None;
    UseRequestPage = false;
    DefaultRenderingLayout = HsfWord;

    dataset
    {
        dataitem(Row; "LT HSF Row")
        {
            column(Id; Id) { }
            column(Txt; Txt) { }
        }
    }

    rendering
    {
        layout(HsfWord)
        {
            Type = Word;
            LayoutFile = './reports/layouts-saveas/LtHsfWord.docx';
        }
    }
}

codeunit 98032 "LT HSF Round Trip"
{
    Subtype = Test;
    TestPermissions = Disabled;

    var
        FileMgt: Codeunit "File Management";

    local procedure Rows()
    var
        Row: Record "LT HSF Row";
        I: Integer;
    begin
        Row.DeleteAll();
        for I := 1 to 2 do begin
            Row.Init();
            Row.Id := I;
            Row.Txt := 'HSFROW' + Format(I) + ' äöü€';
            Row.Insert();
        end;
    end;

    [TryFunction]
    local procedure TrySave(Fmt: ReportFormat; var TempBlob: Codeunit "Temp Blob"; var Saved: Boolean)
    var
        OutS: OutStream;
    begin
        TempBlob.CreateOutStream(OutS, TextEncoding::UTF8);
        Saved := Report.SaveAs(Report::"LT HSF Word Rpt", '', Fmt, OutS);
    end;

    local procedure CopyBlob(var Source: Codeunit "Temp Blob"; var Target: Codeunit "Temp Blob")
    var
        InS: InStream;
        OutS: OutStream;
    begin
        Source.CreateInStream(InS);
        Target.CreateOutStream(OutS);
        CopyStream(OutS, InS);
    end;

    local procedure Base64(var TempBlob: Codeunit "Temp Blob"): Text
    var
        Base64Convert: Codeunit "Base64 Convert";
        InS: InStream;
    begin
        TempBlob.CreateInStream(InS);
        exit(Base64Convert.ToBase64(InS));
    end;

    local procedure ReadWhole(var TempBlob: Codeunit "Temp Blob"): Text
    var
        InS: InStream;
        Body: Text;
    begin
        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        InS.Read(Body);
        exit(Body);
    end;

    // Saves the report into TempBlob, records the answer and HasValue, and takes the direct copy.
    local procedure SaveFacts(var Observer: Codeunit "Probe Observer"; Fmt: ReportFormat; var TempBlob: Codeunit "Temp Blob"; var Direct: Codeunit "Temp Blob")
    var
        Saved: Boolean;
        Ok: Boolean;
    begin
        Rows();
        ClearLastError();
        Ok := TrySave(Fmt, TempBlob, Saved);
        Observer.Observe('save ok', Format(Ok));
        if not Ok then
            Observer.ObserveError('save error');
        Observer.Observe('saved', Format(Saved));
        Observer.Observe('HasValue after SaveAs', Format(TempBlob.HasValue()));
        CopyBlob(TempBlob, Direct);
    end;

    local procedure ImportFacts(var Observer: Codeunit "Probe Observer"; Path: Text; var TempBlob: Codeunit "Temp Blob"; var Direct: Codeunit "Temp Blob"; Html: Boolean)
    begin
        Observer.Observe('file exists after export', Format(Exists(Path)));
        Clear(TempBlob);
        Observer.Observe('HasValue after Clear', Format(TempBlob.HasValue()));
        FileMgt.BLOBImportFromServerFile(TempBlob, Path);
        Observer.Observe('HasValue after import', Format(TempBlob.HasValue()));
        Observer.Observe('length = direct copy', Format(TempBlob.Length() = Direct.Length()));
        Observer.Observe('base64 = direct copy', Format(Base64(TempBlob) = Base64(Direct)));
        if Html then
            Observer.Observe('Read(Text) = direct copy', Format(ReadWhole(TempBlob) = ReadWhole(Direct)));
    end;

    local procedure DeleteFacts(var Observer: Codeunit "Probe Observer"; Path: Text)
    begin
        Observer.Observe('DeleteServerFile', Format(FileMgt.DeleteServerFile(Path)));
        Observer.Observe('file exists after delete', Format(Exists(Path)));
        Observer.Observe('DeleteServerFile again', Format(FileMgt.DeleteServerFile(Path)));
    end;

    // TempBlobToServerFile as the Base Application does it (internal there).
    local procedure TempBlobToServerFile(var TempBlob: Codeunit "Temp Blob"; FileExt: Text): Text
    var
        InS: InStream;
    begin
        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        exit(CopyStr(FileMgt.InstreamExportToServerFile(InS, FileExt), 1, 250));
    end;

    [Test]
    procedure HSF_Html_TempBlobToServerFile_RoundTrip()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        Direct: Codeunit "Temp Blob";
        Path: Text;
    begin
        SaveFacts(Observer, ReportFormat::Html, TempBlob, Direct);
        Path := TempBlobToServerFile(TempBlob, 'html');
        Observer.Observe('path ends with .html', Format(Path.EndsWith('.html')));
        ImportFacts(Observer, Path, TempBlob, Direct, true);
        DeleteFacts(Observer, Path);
        Observer.Finish();
    end;

    [Test]
    procedure HSF_Html_BLOBExportToServerFile_RoundTrip()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        Direct: Codeunit "Temp Blob";
        Path: Text;
    begin
        SaveFacts(Observer, ReportFormat::Html, TempBlob, Direct);
        Path := FileMgt.ServerTempFileName('html');
        Observer.Observe('path ends with .html', Format(Path.EndsWith('.html')));
        Observer.Observe('file exists before export', Format(Exists(Path)));
        FileMgt.BLOBExportToServerFile(TempBlob, Path);
        ImportFacts(Observer, Path, TempBlob, Direct, true);
        DeleteFacts(Observer, Path);
        Observer.Finish();
    end;

    [Test]
    procedure HSF_Pdf_TempBlobToServerFile_RoundTrip()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        Direct: Codeunit "Temp Blob";
        Path: Text;
    begin
        SaveFacts(Observer, ReportFormat::Pdf, TempBlob, Direct);
        Path := TempBlobToServerFile(TempBlob, 'pdf');
        Observer.Observe('path ends with .pdf', Format(Path.EndsWith('.pdf')));
        ImportFacts(Observer, Path, TempBlob, Direct, false);
        DeleteFacts(Observer, Path);
        Observer.Finish();
    end;

    [Test]
    procedure HSF_Html_ExportWithoutEncoding_SameBytes()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        Direct: Codeunit "Temp Blob";
        InS: InStream;
        Path: Text;
    begin
        SaveFacts(Observer, ReportFormat::Html, TempBlob, Direct);
        TempBlob.CreateInStream(InS);
        Path := FileMgt.InstreamExportToServerFile(InS, 'html');
        ImportFacts(Observer, Path, TempBlob, Direct, true);
        DeleteFacts(Observer, Path);
        Observer.Finish();
    end;

    [Test]
    procedure HSF_DeleteServerFile_PathThatDoesNotExist()
    var
        Observer: Codeunit "Probe Observer";
        Path: Text;
    begin
        Path := FileMgt.ServerTempFileName('html');
        Observer.Observe('exists', Format(Exists(Path)));
        Observer.Observe('DeleteServerFile', Format(FileMgt.DeleteServerFile(Path)));
        Observer.Observe('exists after', Format(Exists(Path)));
        Observer.Finish();
    end;

    [Test]
    procedure HSF_Html_ByHandWithFile_RoundTrip()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        Direct: Codeunit "Temp Blob";
        TempFile: File;
        OutFile: File;
        InFile: File;
        InS: InStream;
        OutS: OutStream;
        Path: Text;
    begin
        SaveFacts(Observer, ReportFormat::Html, TempBlob, Direct);
        TempFile.CreateTempFile();
        Path := TempFile.Name() + '.html';
        TempFile.Close();
        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        OutFile.WriteMode(true);
        OutFile.Create(Path);
        OutFile.CreateOutStream(OutS);
        CopyStream(OutS, InS);
        OutFile.Close();
        Observer.Observe('file exists after export', Format(Exists(Path)));
        Clear(TempBlob);
        Observer.Observe('HasValue after Clear', Format(TempBlob.HasValue()));
        InFile.Open(Path);
        InFile.CreateInStream(InS);
        TempBlob.CreateOutStream(OutS);
        CopyStream(OutS, InS);
        InFile.Close();
        Observer.Observe('HasValue after import', Format(TempBlob.HasValue()));
        Observer.Observe('length = direct copy', Format(TempBlob.Length() = Direct.Length()));
        Observer.Observe('base64 = direct copy', Format(Base64(TempBlob) = Base64(Direct)));
        Observer.Observe('Read(Text) = direct copy', Format(ReadWhole(TempBlob) = ReadWhole(Direct)));
        Erase(Path);
        Observer.Observe('file exists after Erase', Format(Exists(Path)));
        Observer.Finish();
    end;
}
