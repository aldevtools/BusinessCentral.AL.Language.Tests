// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/methods-auto/report/report-saveas-method
// Scope: in-scope
// Fixtures used: Probe Observer (69160); HT Row, HT Body, HT Body Page, HT Log, HT Word Rpt, HT Quit Rpt and HT Subscribers of HtFixtures.al
// Probe: written against the al-runtime-rs ADR-040 amendment of 2026-11-12 (opaque rendered content in Text values, section A9 probes 1 to 4,
//   the probe cells of A2, A3 and A7). A report with a Word layout (generated by the compiler, no content controls) is saved as Html into a
//   Temp Blob on a UTF-8 stream, as Report Selections.DoSaveReportAsHTMLInTempBlob does, and read back whole with InStream.Read(Text).
// Facts asked, never the characters of the Html itself:
//   - the read: is it whole (EOS after it), is it not empty, does ReadText of one line, a read without an encoding, a BigText read give the same text;
//   - the moves of A3: Format, TextBuilder, StrSubstNo, Variant, List, Dictionary, BigText, stream round trips per encoding, a Blob field,
//     Email Message.Create and GetBody, Email Item.SetBody and GetBodyTextFromBlob, the order of joined text, a #n field of StrSubstNo;
//   - TestField.Value() of a plain, a MultiLine, a RichContent and a hidden MultiLine control over a Text variable (short, long, long with
//     line breaks and markup, the Html body);
//   - Format(BigText) of long texts;
//   - SaveAs Html of a run with no dataset row and of runs ended by CurrReport.Quit (OnPreReport, OnAfterGetRecord, OnPostReport);
//   - a temporary layout selection before SaveAs: default, empty name, the other Word layout by name with and without the app id, a
//     user-defined Tenant Report Layout row named by a GUID, a name and a custom layout code that match nothing; the answer, the error and
//     the Reporting Triggers events in their order inside SaveAs (the layoutname of OnDocumentReady says which layout was used).
// Measured on BC 27.5 and 28.5 (Windows containers, identical answers); BC 29.0 not measured locally (its container failed to publish).
// The four FieldValue_* tests are still in observe form: the local run reported them passed without an observation (not measured).
// BC versions: 27 - 29

codeunit 75210 "HT Rendered Text Tests"
{
    Subtype = Test;
    TestPermissions = Disabled;

    var
        HtLog: Codeunit "HT Log";
        TenantLayoutNameTxt: Label '{5B0C6E2A-7D41-4F3B-9C1E-2A6B8D4F0E17}', Locked = true;

    local procedure Rows(N: Integer)
    var
        Row: Record "HT Row";
        I: Integer;
    begin
        Row.DeleteAll();
        for I := 1 to N do begin
            Row.Init();
            Row.Id := I;
            Row.Txt := 'HTROW' + Format(I);
            Row.Insert();
        end;
    end;

    [TryFunction]
    local procedure TrySaveHtml(ReportId: Integer; var TempBlob: Codeunit "Temp Blob"; var Saved: Boolean)
    var
        OutS: OutStream;
    begin
        TempBlob.CreateOutStream(OutS, TextEncoding::UTF8);
        Saved := Report.SaveAs(ReportId, '', ReportFormat::Html, OutS);
    end;

    local procedure ReadBody(var TempBlob: Codeunit "Temp Blob"): Text
    var
        InS: InStream;
        Body: Text;
    begin
        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        InS.Read(Body);
        exit(Body);
    end;

    // Saves report ReportId as Html with the log on and records the answer. Returns the body read whole.
    local procedure SaveFacts(var Observer: Codeunit "Probe Observer"; ReportId: Integer; var TempBlob: Codeunit "Temp Blob"): Text
    var
        Saved: Boolean;
        Ok: Boolean;
        Body: Text;
    begin
        HtLog.Start();
        ClearLastError();
        Ok := TrySaveHtml(ReportId, TempBlob, Saved);
        Observer.Observe('log', HtLog.Take().Replace(TenantLayoutNameTxt, '<tenant layout>'));
        Observer.Observe('ok', Format(Ok));
        if not Ok then
            Observer.ObserveError('error');
        Observer.Observe('saved', Format(Saved));
        Observer.Observe('length > 0', Format(TempBlob.Length() > 0));
        Observer.Observe('length > 1000', Format(TempBlob.Length() > 1000));
        Body := ReadBody(TempBlob);
        Observer.Observe('body <> empty', Format(Body <> ''));
        Observer.Observe('body starts with <', Format(CopyStr(Body, 1, 1) = '<'));
        exit(Body);
    end;

    local procedure RenderBody(): Text
    var
        TempBlob: Codeunit "Temp Blob";
        Saved: Boolean;
    begin
        Rows(2);
        if not TrySaveHtml(Report::"HT Word Rpt", TempBlob, Saved) then
            exit('<save failed>');
        exit(ReadBody(TempBlob));
    end;

    [Test]
    procedure Html_SaveAs_ReadWhole()
    var
        Observer: Codeunit "Probe Observer";
        TempBlob: Codeunit "Temp Blob";
        BigTxt: BigText;
        InS: InStream;
        Body: Text;
        Other: Text;
        Second: Text;
        N: Integer;
    begin
        Rows(2);
        Body := SaveFacts(Observer, Report::"HT Word Rpt", TempBlob);
        Observer.Observe('body over 1000 characters', Format(StrLen(Body) > 1000));

        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        N := InS.Read(Other);
        Observer.Observe('read answer = StrLen', Format(N = StrLen(Other)));
        Observer.Observe('EOS after read', Format(InS.EOS()));
        Observer.Observe('second read', Format(InS.Read(Second)));
        Observer.Observe('second read text empty', Format(Second = ''));

        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        InS.ReadText(Other);
        Observer.Observe('ReadText one line = body', Format(Other = Body));

        TempBlob.CreateInStream(InS);
        InS.Read(Other);
        Observer.Observe('read without encoding = body', Format(Other = Body));

        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        BigTxt.Read(InS);
        BigTxt.GetSubText(Other, 1);
        Observer.Observe('BigText.Read GetSubText = body', Format(Other = Body));
        Observer.Observe('BigText.Length = StrLen', Format(BigTxt.Length() = StrLen(Body)));
        Observer.Observe('Format(BigText) = body', Format(Format(BigTxt) = Body));
        Observer.Expect('log', 'SubstituteReport(SaveAs);SelectReportLayoutCode;SelectedBuiltinLayoutType;OnPreReport;OnPreRendering;OnDocumentReady(text/html,HtWordMain);OnPostReport;');
        Observer.Expect('ok', 'Yes');
        Observer.Expect('saved', 'Yes');
        Observer.Expect('length > 0', 'Yes');
        Observer.Expect('length > 1000', 'No');
        Observer.Expect('body <> empty', 'Yes');
        Observer.Expect('body starts with <', 'Yes');
        Observer.Expect('body over 1000 characters', 'No');
        Observer.Expect('read answer = StrLen', 'No');
        Observer.Expect('EOS after read', 'Yes');
        Observer.Expect('second read', '1');
        Observer.Expect('second read text empty', 'Yes');
        Observer.Expect('ReadText one line = body', 'Yes');
        Observer.Expect('read without encoding = body', 'Yes');
        Observer.Expect('BigText.Read GetSubText = body', 'Yes');
        Observer.Expect('BigText.Length = StrLen', 'Yes');
        Observer.Expect('Format(BigText) = body', 'Yes');
        Observer.Verify();
    end;

    [Test]
    procedure Html_Body_TextMoves()
    var
        Observer: Codeunit "Probe Observer";
        TB: TextBuilder;
        V: Variant;
        L: List of [Text];
        D: Dictionary of [Integer, Text];
        BigTxt: BigText;
        Body: Text;
        Other: Text;
    begin
        Body := RenderBody();
        Observer.Observe('body <> empty', Format(Body <> ''));
        Observer.Observe('Format = body', Format(Format(Body) = Body));
        TB.Append(Body);
        Observer.Observe('TextBuilder.ToText = body', Format(TB.ToText() = Body));
        Observer.Observe('known + body <> empty', Format(('Sig ' + Body) <> ''));
        Observer.Observe('StrSubstNo %1 = body', Format(StrSubstNo('%1', Body) = Body));
        Observer.Observe('StrSubstNo #1 width 10 = 10 stars', Format(StrSubstNo('#1########', Body) = '**********'));
        V := Body;
        Observer.Observe('Variant IsText', Format(V.IsText()));
        Observer.Observe('Format(Variant) = body', Format(Format(V) = Body));
        L.Add(Body);
        Observer.Observe('List.Get = body', Format(L.Get(1) = Body));
        D.Add(1, Body);
        Observer.Observe('Dictionary.Get = body', Format(D.Get(1) = Body));
        BigTxt.AddText(Body);
        BigTxt.GetSubText(Other, 1);
        Observer.Observe('BigText.AddText GetSubText = body', Format(Other = Body));
        Observer.Observe('body = known text', Format(Body = 'Body'));
        Observer.Observe('(Body + body) < body', Format(('Body ' + Body) < 'body'));
        Observer.Observe('body < a', Format(Body < 'a'));
        Observer.Expect('body <> empty', 'Yes');
        Observer.Expect('Format = body', 'Yes');
        Observer.Expect('TextBuilder.ToText = body', 'Yes');
        Observer.Expect('known + body <> empty', 'Yes');
        Observer.Expect('StrSubstNo %1 = body', 'Yes');
        Observer.Expect('StrSubstNo #1 width 10 = 10 stars', 'Yes');
        Observer.Expect('Variant IsText', 'Yes');
        Observer.Expect('Format(Variant) = body', 'Yes');
        Observer.Expect('List.Get = body', 'Yes');
        Observer.Expect('Dictionary.Get = body', 'Yes');
        Observer.Expect('BigText.AddText GetSubText = body', 'Yes');
        Observer.Expect('body = known text', 'No');
        Observer.Expect('(Body + body) < body', 'No');
        Observer.Expect('body < a', 'Yes');
        Observer.Verify();
    end;

    local procedure RoundTrip(Body: Text; Encoding: TextEncoding; UseWrite: Boolean): Boolean
    var
        TempBlob: Codeunit "Temp Blob";
        OutS: OutStream;
        InS: InStream;
        Other: Text;
    begin
        TempBlob.CreateOutStream(OutS, Encoding);
        if UseWrite then
            OutS.Write(Body)
        else
            OutS.WriteText(Body);
        TempBlob.CreateInStream(InS, Encoding);
        InS.Read(Other);
        exit(Other = Body);
    end;

    [Test]
    procedure Html_Body_StreamAndBlobRoundTrips()
    var
        Observer: Codeunit "Probe Observer";
        BodyRow: Record "HT Body";
        TempBlob: Codeunit "Temp Blob";
        BigTxt: BigText;
        Other: BigText;
        OutS: OutStream;
        InS: InStream;
        Body: Text;
        Back: Text;
    begin
        BodyRow.DeleteAll();
        Body := RenderBody();
        Observer.Observe('UTF8 WriteText Read = body', Format(RoundTrip(Body, TextEncoding::UTF8, false)));
        Observer.Observe('UTF8 Write Read = body', Format(RoundTrip(Body, TextEncoding::UTF8, true)));
        Observer.Observe('UTF16 WriteText Read = body', Format(RoundTrip(Body, TextEncoding::UTF16, false)));
        Observer.Observe('Windows WriteText Read = body', Format(RoundTrip(Body, TextEncoding::Windows, false)));
        Observer.Observe('MSDos WriteText Read = body', Format(RoundTrip(Body, TextEncoding::MSDos, false)));

        BigTxt.AddText(Body);
        TempBlob.CreateOutStream(OutS, TextEncoding::UTF8);
        BigTxt.Write(OutS);
        TempBlob.CreateInStream(InS, TextEncoding::UTF8);
        Other.Read(InS);
        Observer.Observe('BigText Write Read = body', Format(Format(Other) = Body));

        BodyRow.Init();
        BodyRow.Id := 1;
        BodyRow.Body.CreateOutStream(OutS, TextEncoding::UTF8);
        OutS.WriteText(Body);
        BodyRow.Insert();
        Clear(BodyRow);
        BodyRow.Get(1);
        BodyRow.CalcFields(Body);
        Observer.Observe('Blob field HasValue', Format(BodyRow.Body.HasValue()));
        BodyRow.Body.CreateInStream(InS, TextEncoding::UTF8);
        InS.Read(Back);
        Observer.Observe('Blob field stored and read = body', Format(Back = Body));
        BodyRow.DeleteAll();
        Observer.Expect('UTF8 WriteText Read = body', 'Yes');
        Observer.Expect('UTF8 Write Read = body', 'Yes');
        Observer.Expect('UTF16 WriteText Read = body', 'Yes');
        Observer.Expect('Windows WriteText Read = body', 'Yes');
        Observer.Expect('MSDos WriteText Read = body', 'Yes');
        Observer.Expect('BigText Write Read = body', 'Yes');
        Observer.Expect('Blob field HasValue', 'Yes');
        Observer.Expect('Blob field stored and read = body', 'Yes');
        Observer.Verify();
    end;

    [Test]
    procedure Html_Body_EmailMessageAndEmailItem()
    var
        Observer: Codeunit "Probe Observer";
        Message: Codeunit "Email Message";
        Signed: Codeunit "Email Message";
        Plain: Codeunit "Email Message";
        TempEmailItem: Record "Email Item" temporary;
        TempBlob: Codeunit "Temp Blob";
        BodyText: BigText;
        OutS: OutStream;
        Body: Text;
        Got: Text;
    begin
        Body := RenderBody();
        Message.Create('ht.probe@contoso.com', 'HT subject', Body, true);
        Got := Message.GetBody();
        Observer.Observe('html Create GetBody <> empty', Format(Got <> ''));
        Observer.Observe('html Create GetBody = body', Format(Got = Body));
        Plain.Create('ht.probe@contoso.com', 'HT subject', Body, false);
        Observer.Observe('plain Create GetBody = body', Format(Plain.GetBody() = Body));

        BodyText.AddText(Got);
        BodyText.AddText('<p>HTSIGNATURE</p>');
        Signed.Create('ht.probe@contoso.com', 'HT subject', Format(BodyText), true);
        Observer.Observe('signed GetBody <> empty', Format(Signed.GetBody() <> ''));
        Observer.Observe('signed GetBody = body + signature', Format(Signed.GetBody() = Got + '<p>HTSIGNATURE</p>'));

        TempBlob.CreateOutStream(OutS, TextEncoding::UTF8);
        OutS.WriteText(Body);
        TempEmailItem.Init();
        TempEmailItem.SetBody(TempBlob);
        Observer.Observe('Email Item GetBodyTextFromBlob = body', Format(TempEmailItem.GetBodyTextFromBlob() = Body));
        TempEmailItem.SetBody(TempBlob, true);
        Observer.Observe('Email Item plain GetBodyTextFromBlob = body', Format(TempEmailItem.GetBodyTextFromBlob() = Body));
        Observer.Expect('html Create GetBody <> empty', 'Yes');
        Observer.Expect('html Create GetBody = body', 'Yes');
        Observer.Expect('plain Create GetBody = body', 'Yes');
        Observer.Expect('signed GetBody <> empty', 'Yes');
        Observer.Expect('signed GetBody = body + signature', 'Yes');
        Observer.Expect('Email Item GetBodyTextFromBlob = body', 'Yes');
        Observer.Expect('Email Item plain GetBodyTextFromBlob = body', 'Yes');
        Observer.Verify();
    end;

