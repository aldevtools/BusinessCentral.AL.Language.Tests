    local procedure LongText(Count: Integer; WithBreaks: Boolean): Text
    var
        TB: TextBuilder;
        CrLf: Text[2];
        Chunks: Integer;
    begin
        CrLf := '..';
        CrLf[1] := 13;
        CrLf[2] := 10;
        if WithBreaks then
            TB.Append('<p>');
        while TB.Length() < Count do begin
            TB.Append('abcdefghij');
            Chunks += 1;
            if WithBreaks and (Chunks mod 10 = 0) then
                TB.Append(CrLf);
        end;
        if WithBreaks then
            TB.Append('</p>');
        exit(TB.ToText());
    end;

    local procedure FieldFacts(var Observer: Codeunit "Probe Observer"; Value: Text)
    var
        BodyPage: TestPage "HT Body Page";
    begin
        HtLog.SetPageText(Value);
        BodyPage.OpenEdit();
        Observer.Observe('plain Value = text', Format(BodyPage.PlainField.Value() = Value));
        Observer.Observe('plain StrLen equal', Format(StrLen(BodyPage.PlainField.Value()) = StrLen(Value)));
        Observer.Observe('multiline Value = text', Format(BodyPage.MultiField.Value() = Value));
        Observer.Observe('multiline StrLen equal', Format(StrLen(BodyPage.MultiField.Value()) = StrLen(Value)));
        Observer.Observe('richcontent Value = text', Format(BodyPage.RichField.Value() = Value));
        Observer.Observe('richcontent StrLen equal', Format(StrLen(BodyPage.RichField.Value()) = StrLen(Value)));
        Observer.Observe('hidden multiline Value = text', Format(BodyPage.HiddenMultiField.Value() = Value));
        Observer.Observe('hidden multiline StrLen equal', Format(StrLen(BodyPage.HiddenMultiField.Value()) = StrLen(Value)));
        BodyPage.Close();
        HtLog.SetPageText('');
    end;

