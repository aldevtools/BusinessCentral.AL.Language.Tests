report 75204 "HT Quit Rpt"
{
    UsageCategory = None;
    DefaultRenderingLayout = HtQuit;

    dataset
    {
        dataitem(HtRow; "HT Row")
        {
            column(HtId; Id)
            {
            }
            column(HtTxt; Txt)
            {
            }

            trigger OnAfterGetRecord()
            begin
                HtLog.Add('OnAfterGetRecord');
                if HtLog.QuitAt('OnAfterGetRecord') then
                    CurrReport.Quit();
            end;
        }
    }

    rendering
    {
        layout(HtQuit)
        {
            Type = Word;
            LayoutFile = './reports/layouts-html-text/HtQuit.docx';
        }
    }

    trigger OnPreReport()
    begin
        HtLog.Add('OnPreReport');
        if HtLog.QuitAt('OnPreReport') then
            CurrReport.Quit();
    end;

    trigger OnPostReport()
    begin
        HtLog.Add('OnPostReport');
        if HtLog.QuitAt('OnPostReport') then
            CurrReport.Quit();
    end;

    trigger OnPreRendering(var RenderingPayload: JsonObject)
    begin
        HtLog.Add('OnPreRendering');
    end;

    var
        HtLog: Codeunit "HT Log";
}

codeunit 75205 "HT Subscribers"
{
    var
        HtLog: Codeunit "HT Log";

    local procedure Mine(ObjectId: Integer): Boolean
    begin
        exit(ObjectId in [Report::"HT Word Rpt", Report::"HT Quit Rpt"]);
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'SubstituteReport', '', false, false)]
    local procedure HtSubstitute(ReportId: Integer; RunMode: Option Normal,ParametersOnly,Execute,Print,SaveAs,RunModal; RequestPageXml: Text; RecordRef: RecordRef; var NewReportId: Integer)
    begin
        if Mine(ReportId) then
            HtLog.Add('SubstituteReport(' + Format(RunMode) + ')');
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'SelectReportLayoutCode', '', false, false)]
    local procedure HtSelectLayoutCode(ObjectId: Integer; var LayoutCode: Text; var LayoutType: Option "None",RDLC,Word,Excel,Custom; var Success: Boolean)
    begin
        if Mine(ObjectId) then
            HtLog.Add('SelectReportLayoutCode');
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'SelectedBuiltinLayoutType', '', false, false)]
    local procedure HtBuiltinLayoutType(ObjectID: Integer; var LayoutType: Option "None",RDLC,Word,Excel,Custom)
    begin
        if Mine(ObjectID) then
            HtLog.Add('SelectedBuiltinLayoutType');
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'FetchReportLayoutByCode', '', false, false)]
    local procedure HtFetchLayout(ObjectId: Integer; LayoutCode: Text; var TargetStream: OutStream; var Success: Boolean)
    begin
        if Mine(ObjectId) then
            HtLog.Add('FetchReportLayoutByCode');
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'OnDocumentReady', '', false, false)]
    local procedure HtDocumentReady(ObjectId: Integer; ObjectPayload: JsonObject; DocumentStream: InStream; var TargetStream: OutStream; var Success: Boolean)
    begin
        // The document stream is not read here: reading it could change what the caller receives.
        if Mine(ObjectId) then
            HtLog.Add('OnDocumentReady(' + Value(ObjectPayload, 'documenttype') + ',' + Value(ObjectPayload, 'layoutname') + ')');
    end;

    [EventSubscriber(ObjectType::Codeunit, Codeunit::"Reporting Triggers", 'OnDocumentDownload', '', false, false)]
    local procedure HtDocumentDownload(ObjectId: Integer; ObjectPayload: JsonObject; DocumentStream: InStream; var Success: Boolean)
    begin
        if Mine(ObjectId) then
            HtLog.Add('OnDocumentDownload');
    end;

    local procedure Value(Payload: JsonObject; KeyName: Text): Text
    var
        Token: JsonToken;
    begin
        if not Payload.Get(KeyName, Token) then
            exit('<absent>');
        if not Token.IsValue() then
            exit('<not a value>');
        exit(Token.AsValue().AsText());
    end;
}
