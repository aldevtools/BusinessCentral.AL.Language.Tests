page 75206 "HT Body Page"
{
    PageType = Card;
    ApplicationArea = All;
    UsageCategory = None;
    Caption = 'HT Body Page';

    layout
    {
        area(Content)
        {
            group(PlainGroup)
            {
                Caption = 'Plain';

                field(PlainField; BodyTxt)
                {
                    ApplicationArea = All;
                    Caption = 'Plain';
                }
            }
            group(MultiGroup)
            {
                Caption = 'Multi';

                field(MultiField; BodyTxt)
                {
                    ApplicationArea = All;
                    Caption = 'Multi';
                    MultiLine = true;
                }
            }
            group(RichGroup)
            {
                Caption = 'Rich';

                field(RichField; BodyTxt)
                {
                    ApplicationArea = All;
                    Caption = 'Rich';
                    MultiLine = true;
                    ExtendedDatatype = RichContent;
                }
            }
            group(HiddenGroup)
            {
                Caption = 'Hidden';
                Visible = false;

                field(HiddenMultiField; BodyTxt)
                {
                    ApplicationArea = All;
                    Caption = 'Hidden multi';
                    MultiLine = true;
                }
            }
        }
    }

    trigger OnOpenPage()
    begin
        BodyTxt := HtLog.PageText();
    end;

    var
        HtLog: Codeunit "HT Log";
        BodyTxt: Text;
}

codeunit 75202 "HT Log"
{
    SingleInstance = true;

    var
        Entries: Text;
        Active: Boolean;
        QuitAtName: Text;
        PageBody: Text;

    procedure Start()
    begin
        Entries := '';
        Active := true;
    end;

    procedure Add(Entry: Text)
    begin
        if Active then
            Entries += Entry + ';';
    end;

    procedure Take(): Text
    var
        Result: Text;
    begin
        Result := Entries;
        Entries := '';
        Active := false;
        exit(Result);
    end;

    procedure SetQuitAt(NewQuitAt: Text)
    begin
        QuitAtName := NewQuitAt;
    end;

    procedure QuitAt(TriggerName: Text): Boolean
    begin
        exit(QuitAtName = TriggerName);
    end;

    procedure SetPageText(NewText: Text)
    begin
        PageBody := NewText;
    end;

    procedure PageText(): Text
    begin
        exit(PageBody);
    end;
}

