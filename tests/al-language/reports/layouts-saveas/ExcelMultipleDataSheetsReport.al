// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/properties/devenv-excellayoutmultipledatasheets-property
// Scope: in-scope
// Fixtures used: Probe Observer (codeunit 69160); Temp Blob (System Application); own reports 76405-76408, test codeunit 76409.
//   LtXmsWord.docx and LtXmsExcel.xlsx were generated by alc /generatereportlayout for these datasets.
// Probe: from al-runner issue 7836: a report that declares ExcelLayoutMultipleDataSheets = true at the report level.
// Facts:
//   - Report.SaveAs Xml of a report with the property (no layout, a Word default layout, an Excel default layout) gives the same
//     dataset as the same report without it (the texts compared after the report name and id are replaced);
//   - Report.Run and Report.RunModal with UseRequestPage false of the report with the property (no layout, an Excel default
//     layout): the error;
//   - Report.SaveAs Excel of the report with the Excel default layout and of the one without a layout: the answer, the error and
//     whether the stream holds bytes.
// BC versions: 27 - 29

report 76405 "LT XMS Plain"
{
    UsageCategory = None;
    UseRequestPage = false;

    dataset
    {
        dataitem(Num; Integer)
        {
            DataItemTableView = where(Number = filter(1 .. 2));
            column(Number; Number) { }
            column(Doubled; Number * 2) { }
        }
        dataitem(Second; Integer)
        {
            DataItemTableView = where(Number = const(7));
            column(SecondNumber; Number) { }
        }
    }
}

