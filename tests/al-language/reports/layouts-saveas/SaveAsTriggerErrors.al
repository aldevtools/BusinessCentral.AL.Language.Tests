// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/methods-auto/report/report-saveas-method
//   https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/methods-auto/system/system-getlasterrortext-method
// Scope: in-scope
// Fixtures used: Probe Observer (codeunit 69160); own objects 77380..77390 (SAE Blob, SAE Mode, SAE Word Rpt, SAE Rdlc Rpt,
//   SAE Excel Rpt, SAE Processing Rpt, SAE No Layout Rpt, SAE No Layout Word Ext, SAE SaveAs Trigger Error Tests,
//   SAE Statement, SAE Cells)
// local object: the report's layout kind (Word, RDLC, Excel, processing only, none with a report extension that adds a Word
//   layout) and the trigger that raises are what is under test. The layout files are generated by the compiler.
// singleinstance-shared-on-purpose: "SAE Mode" carries the error site and format from the cells into the report triggers.
// Probe (al-runner issue 8486, item 3): an error raised inside Report.SaveAs, by the report's own triggers. Does SaveAs raise it
//   or answer false, per layout kind, error site, output format and call form?
// Error sites ("SAE Mode", SingleInstance, holds the site): OnPreReport Error('E1'); the data item's OnAfterGetRecord
//   Error('E2'); OnPreDataItem TestField(Tag) of an empty "SAE Blob" record (its key is blank); OnPostReport Error('E3'); and a
//   control without an error. The data item is Integer, SetRange(Number, 1, 1) in OnPreDataItem; nothing is written to a table.
// Call forms: the statement Report.SaveAs(Id, '', Format, OutStream) run inside Codeunit.Run ("SAE Statement"), and the Boolean
//   form if Report.SaveAs(...) then; each followed by GetLastErrorCode and GetLastErrorText. One test per layout kind and error
//   site runs six calls in this order: Pdf statement, Pdf Boolean, Word statement, Word Boolean, Xml statement, Xml Boolean.
//   Each call is one observation, in the text form 'raised <code>/<text>', 'returned, nonempty=<Yes|No>',
//   'false, last=<code>/<text>' or 'true, nonempty=<Yes|No>, last=<text>'. The report id and the table caption in BC's texts
//   are taken from this file's objects.
// Facts (measured on BC 29 (Linux host) with an invented app, each test run alone; this pull request's CI checks 27.5, 28.5
//   and 29.0):
//   - SaveAs never swallows an error. The statement form raises the trigger's error; the Boolean form answers false with the
//     same text and code in GetLastErrorText / GetLastErrorCode (Dialog for E1, E2, E3; TestField for the TestField text). This
//     holds for every layout kind, error site and format measured.
//   - Word layout: the control saves a non-empty file in every format and form (the Boolean form answers true).
//   - Excel layout: Pdf and Word raise (or answer false with) ReportUnsupportedFormat 'The Pdf output format is not supported by
//     the current report layout format.' ('The Word output format ...' for Word) at every site, the control included: the
//     trigger is never reached. Xml behaves as for the Word layout.
//   - Processing only: every format and site raises (or answers false with) ReportProcessingOnly 'Report <id> is a
//     processing-only report. Output cannot be rendered and saved to a file.'; no trigger error is reached.
//   - No layout, with a report extension that adds a Word layout: Pdf and Word raise (or answer false with) ReportNoLayout
//     'Report <id> does not have a valid layout. Valid layout types are: Word, RDLC, Excel, and Custom.': the extension's
//     layout is not taken as the default. Xml behaves as for the Word layout.
//   - RDLC layout: as the Word layout for OnPreReport, OnAfterGetRecord and the TestField in every format, and for every Xml
//     cell (OnPostReport as Xml raises E3, or answers false with it).
// RDLC caveat: the measuring host renders no RDLC (BC on Linux answers with a stub text instead), so the RDLC calls that reach
//   rendering were not measured: in the control and OnPostReport tests, the Pdf and Word calls in both forms (8 cells). They
//   still run, in the measured order, but are ignored, not asserted. Every other RDLC cell errors, or writes Xml, before any
//   rendering, and is asserted.
// BC versions: 27.5, 28.5, 29.0


table 77380 "SAE Blob"
{
    DataClassification = SystemMetadata;

    fields
    {
        field(1; Code; Code[20]) { }
        field(2; Tag; Code[20]) { }
        field(3; Data; Blob) { }
        field(4; Amount; Decimal) { }
    }

    keys
    {
        key(PK; Code) { Clustered = true; }
    }
}

// The cell's report, error site and format, and the statement form's stream length. Site: 0 none (control), 1 OnPreReport,
// 2 OnAfterGetRecord, 3 OnPreDataItem TestField of an empty field, 4 OnPostReport.
codeunit 77381 "SAE Mode"
{
    SingleInstance = true;

    var
        Site: Integer;
        Fmt: ReportFormat;
        RepId: Integer;
        Len: Integer;

    procedure Set(NewRep: Integer; NewSite: Integer; NewFmt: ReportFormat)
    begin
        RepId := NewRep;
        Site := NewSite;
        Fmt := NewFmt;
    end;

    procedure GetFmt(): ReportFormat
    begin
        exit(Fmt);
    end;

    procedure GetRep(): Integer
    begin
        exit(RepId);
    end;

    procedure SetLen(N: Integer)
    begin
        Len := N;
    end;

    procedure GetLen(): Integer
    begin
        exit(Len);
    end;

    procedure Fire(Where: Integer)
    var
        Empty: Record "SAE Blob";
    begin
        if Site <> Where then
            exit;
        case Where of
            1:
                Error('E1');
            2:
                Error('E2');
            3:
                Empty.TestField(Tag);
            4:
                Error('E3');
        end;
    end;
}

