// The statement form, run inside Codeunit.Run so a raised error's code and text can be read afterwards.
codeunit 77389 "SAE Statement"
{
    trigger OnRun()
    var
        Mode: Codeunit "SAE Mode";
        TempB: Record "SAE Blob" temporary;
        OutS: OutStream;
    begin
        TempB.Data.CreateOutStream(OutS);
        Report.SaveAs(Mode.GetRep(), '', Mode.GetFmt(), OutS);
        Mode.SetLen(TempB.Data.Length);
    end;
}

// Runs the six calls of a cell and observes each one: Pdf, Word, Xml, each as a statement and in the Boolean form.
codeunit 77390 "SAE Cells"
{
    procedure Cell(var Observer: Codeunit "Probe Observer"; Rep: Integer; Site: Integer)
    var
        Fmts: array[3] of ReportFormat;
        Names: array[3] of Text;
        I: Integer;
    begin
        Fmts[1] := ReportFormat::Pdf;
        Fmts[2] := ReportFormat::Word;
        Fmts[3] := ReportFormat::Xml;
        Names[1] := 'Pdf';
        Names[2] := 'Word';
        Names[3] := 'Xml';
        for I := 1 to 3 do begin
            Statement(Observer, Rep, Site, Fmts[I], Names[I]);
            BooleanForm(Observer, Rep, Site, Fmts[I], Names[I]);
        end;
    end;

    local procedure Statement(var Observer: Codeunit "Probe Observer"; Rep: Integer; Site: Integer; Fmt: ReportFormat; Name: Text)
    var
        Mode: Codeunit "SAE Mode";
    begin
        Mode.Set(Rep, Site, Fmt);
        Mode.SetLen(-1);
        ClearLastError();
        if Codeunit.Run(Codeunit::"SAE Statement") then
            Observer.Observe(Name + ' stmt', 'returned, nonempty=' + Format(Mode.GetLen() > 0))
        else
            Observer.Observe(Name + ' stmt', 'raised ' + GetLastErrorCode() + '/' + GetLastErrorText());
    end;

    local procedure BooleanForm(var Observer: Codeunit "Probe Observer"; Rep: Integer; Site: Integer; Fmt: ReportFormat; Name: Text)
    var
        Mode: Codeunit "SAE Mode";
        TempB: Record "SAE Blob" temporary;
        OutS: OutStream;
    begin
        Mode.Set(Rep, Site, Fmt);
        ClearLastError();
        TempB.Data.CreateOutStream(OutS);
        if Report.SaveAs(Rep, '', Fmt, OutS) then
            Observer.Observe(Name + ' bool', 'true, nonempty=' + Format(TempB.Data.Length > 0) + ', last=' + GetLastErrorText())
        else
            Observer.Observe(Name + ' bool', 'false, last=' + GetLastErrorCode() + '/' + GetLastErrorText());
    end;
}

