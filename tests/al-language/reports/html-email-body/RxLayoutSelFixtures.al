// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/devenv-report-layouts
// Scope: in-scope
// Fixtures used: table RX Row (80012) of RxHtmlBodyFixtures.al; used by test codeunits 80023 and 80024
// Facts: the reports and the log of the layout selection probes (al-runner issue 6924).
//   RX Sel Word: three Word layouts and one RDLC layout. Each Word layout (hand-built, RxSel*.docx) carries one marker text in
//   its static part, so the Html says which layout was used: RXSELMAIN (the default), RXSELOTHER, RXSELTENANT (copied into a
//   Tenant Report Layout row by the tests). RxSelRdlc.rdl is generated by the AL compiler (not committed).
//   RX Word Rgba: one Word layout (RxWordRgba.docx, hand-built) whose static text holds rgba(...) and rgb(...) texts.
//   RX Legacy Word (DefaultLayout = Word, WordLayout), RX Two Items (parent and child data item), RX Ext Base with the reportextension
//   RX Ext Column (adds a column): Word layouts the AL compiler generates (not committed).
//   RX Sel Log: the report triggers of RX Sel Word write to it; only test codeunit 80023 reads it.
// local object: the reports' own marked layouts and their trigger log are what the tests check.
// BC versions: 27 - 29

report 80020 "RX Sel Word"
{
    UsageCategory = None;
    UseRequestPage = false;
    DefaultRenderingLayout = RxSelMain;

    dataset
    {
        dataitem(Row; "RX Row")
        {
            column(RowId; Id) { }
            column(RowTxt; Txt) { }
        }
    }

    rendering
    {
        layout(RxSelMain)
        {
            Type = Word;
            LayoutFile = './reports/html-email-body/RxSelMain.docx';
        }
        layout(RxSelOther)
        {
            Type = Word;
            LayoutFile = './reports/html-email-body/RxSelOther.docx';
        }
        layout(RxSelTenant)
        {
            Type = Word;
            LayoutFile = './reports/html-email-body/RxSelTenant.docx';
        }
        layout(RxSelRdlc)
        {
            Type = RDLC;
            LayoutFile = './reports/html-email-body/RxSelRdlc.rdl';
        }
    }

    trigger OnPreReport()
    begin
        SelLog.Add('OnPreReport');
    end;

    trigger OnPostReport()
    begin
        SelLog.Add('OnPostReport');
    end;

    trigger OnPreRendering(var RenderingPayload: JsonObject)
    begin
        SelLog.Add('OnPreRendering');
    end;

    var
        SelLog: Codeunit "RX Sel Log";
}

