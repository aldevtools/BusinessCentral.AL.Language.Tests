codeunit 80022 "RX Sel Log"
{
    SingleInstance = true;

    var
        Entries: Text;
        Active: Boolean;

    procedure Start()
    begin
        Entries := '';
        Active := true;
    end;

    procedure Add(Entry: Text)
    begin
        if Active then
            Entries += Entry + ';';
    end;

    procedure Take(): Text
    var
        Result: Text;
    begin
        Result := Entries;
        Entries := '';
        Active := false;
        exit(Result);
    end;
}

