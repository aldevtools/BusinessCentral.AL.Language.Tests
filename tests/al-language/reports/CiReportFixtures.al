// Word is the default layout, Excel a second layout. Logs TargetFormat, and PageNo of every row (rows 1..60).
report 84587 "LT CI Layouts Rpt"
{
    UseRequestPage = false;
    DefaultRenderingLayout = LtCiLayoutsWord;

    dataset
    {
        dataitem(Numbers; Integer)
        {
            DataItemTableView = where(Number = filter(1 .. 60));
            column(Number; Number) { }

            trigger OnAfterGetRecord()
            begin
                if not PageNos.Contains(Format(CurrReport.PageNo())) then
                    PageNos += Format(CurrReport.PageNo()) + ',';
            end;
        }
    }

    rendering
    {
        layout(LtCiLayoutsWord)
        {
            Type = Word;
            LayoutFile = './reports/LtCiLayoutsWord.docx';
        }
        layout(LtCiLayoutsExcel)
        {
            Type = Excel;
            LayoutFile = './reports/LtCiLayoutsExcel.xlsx';
        }
    }

    trigger OnPreReport()
    begin
        L.Add('pre targetformat=' + Format(CurrReport.TargetFormat()));
    end;

    trigger OnPostReport()
    begin
        L.Add('post pagenos=' + PageNos);
    end;

    var
        L: Codeunit "LT CI Log";
        PageNos: Text;
}

