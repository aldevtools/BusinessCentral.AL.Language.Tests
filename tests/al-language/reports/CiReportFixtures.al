// OnPostReport starts UI or another report, chosen by the log mode: 1 Page.Run, 2 Page.RunModal, 3 Report.Run, 4 Report.RunModal, 5 Report.SaveAs Xml.
report 84585 "LT CI PostUi Rpt"
{
    ProcessingOnly = true;
    UseRequestPage = false;

    dataset
    {
        dataitem(Row; Integer)
        {
            DataItemTableView = where(Number = const(1));
        }
    }

    trigger OnPostReport()
    var
        TempBlob: Codeunit "Temp Blob";
        OutS: OutStream;
    begin
        L.Add('post begin');
        case L.Mode() of
            1:
                Page.Run(Page::"LT CI Row Card");
            2:
                L.Add('runmodal=' + Format(Page.RunModal(Page::"LT CI Row Card")));
            3:
                Report.Run(Report::"LT CI Plain Rpt", false);
            4:
                Report.RunModal(Report::"LT CI Plain Rpt", false);
            5:
                begin
                    TempBlob.CreateOutStream(OutS);
                    L.Add('saveas=' + Format(Report.SaveAs(Report::"LT CI NoLayout Rpt", '', ReportFormat::Xml, OutS)) + ' length>0=' + Format(TempBlob.Length() > 0));
                end;
        end;
        L.Add('post end');
    end;

    var
        L: Codeunit "LT CI Log";
}

