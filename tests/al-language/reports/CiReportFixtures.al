// Not processing-only and no layout: SaveAs Xml renders the dataset. OnPreReport logs TargetFormat; mode 1 sets an invalid FormatRegion, mode 2 an empty one.
report 84583 "LT CI NoLayout Rpt"
{
    UseRequestPage = false;

    dataset
    {
        dataitem(Row; "LT CI Row")
        {
            column(Id; Id) { }

            trigger OnAfterGetRecord()
            begin
                L.Add('row ' + Format(Id) + ' pageno=' + Format(CurrReport.PageNo()));
            end;
        }
    }

    trigger OnPreReport()
    begin
        L.Add('pre targetformat=' + Format(CurrReport.TargetFormat()));
        case L.Mode() of
            1:
                CurrReport.FormatRegion := 'xx-NOPE';
            2:
                CurrReport.FormatRegion := '';
            3:
                CurrReport.FormatRegion := 'de-DE';
        end;
        if L.Mode() in [1, 2, 3] then
            L.Add('region=[' + CurrReport.FormatRegion() + '] dec=' + Format(1234.5));
    end;

    trigger OnPostReport()
    begin
        L.Add('post');
    end;

    var
        L: Codeunit "LT CI Log";
}

