// A request page option and a global set by a procedure; OnPreReport logs both.
report 84590 "LT CI Opt Rpt"
{
    ProcessingOnly = true;

    dataset
    {
        dataitem(Row; Integer)
        {
            DataItemTableView = where(Number = const(1));
        }
    }

    requestpage
    {
        layout
        {
            area(Content)
            {
                field(OptTextCtl; OptText) { ApplicationArea = All; }
            }
        }
    }

    trigger OnPreReport()
    begin
        L.Add('pre opt=[' + OptText + '] marker=[' + Marker + ']');
    end;

    procedure SetOpt(NewValue: Text)
    begin
        OptText := NewValue;
    end;

    procedure GetOpt(): Text
    begin
        exit(OptText);
    end;

    procedure SetMarker(NewValue: Text)
    begin
        Marker := NewValue;
    end;

    procedure GetMarker(): Text
    begin
        exit(Marker);
    end;

    var
        L: Codeunit "LT CI Log";
        OptText: Text;
        Marker: Text;
}

