codeunit 75470 "SAE Helper"
{
    // Rows in SAE A, SAE B and SAE C (the old rows are deleted first).
    procedure Fill(ACount: Integer; BCount: Integer; CCount: Integer)
    var
        A: Record "SAE A";
        B: Record "SAE B";
        C: Record "SAE C";
        I: Integer;
    begin
        A.DeleteAll();
        B.DeleteAll();
        C.DeleteAll();
        for I := 1 to ACount do begin
            A.Id := I;
            A.Insert();
        end;
        for I := 1 to BCount do begin
            B.Id := I;
            B.Insert();
        end;
        for I := 1 to CCount do begin
            C.Id := I;
            C.Insert();
        end;
    end;

    [TryFunction]
    local procedure TrySave(ReportId: Integer; Fmt: ReportFormat; var TempBlob: Codeunit "Temp Blob"; var Ok: Boolean)
    var
        OutS: OutStream;
    begin
        TempBlob.CreateOutStream(OutS);
        Ok := Report.SaveAs(ReportId, '', Fmt, OutS);
    end;

    // The first four bytes of the stream as numbers ('37,80,68,70,' is %PDF, '80,75,3,4,' a zip package), 'empty' for no byte.
    local procedure FirstBytes(var TempBlob: Codeunit "Temp Blob"): Text
    var
        InS: InStream;
        B: Byte;
        I: Integer;
        Result: Text;
    begin
        if TempBlob.Length() = 0 then
            exit('empty');
        TempBlob.CreateInStream(InS);
        for I := 1 to 4 do
            if not InS.EOS() then begin
                InS.Read(B);
                Result += Format(B) + ',';
            end;
        exit(Result);
    end;

    // Saves the report as Fmt into a Temp Blob and observes: did SaveAs complete, what did it return, the error, whether the stream holds bytes, and the first bytes.
    procedure SaveFacts(var Observer: Codeunit "Probe Observer"; Name: Text; ReportId: Integer; Fmt: ReportFormat)
    var
        TempBlob: Codeunit "Temp Blob";
        Completed: Boolean;
        Ok: Boolean;
    begin
        ClearLastError();
        Completed := TrySave(ReportId, Fmt, TempBlob, Ok);
        Observer.Observe(Name + ' completed', Format(Completed));
        Observer.Observe(Name + ' returned', Format(Ok));
        Observer.ObserveError(Name + ' err');
        Observer.Observe(Name + ' length > 0', Format(TempBlob.Length() > 0));
        Observer.Observe(Name + ' head', FirstBytes(TempBlob));
    end;

    procedure AllFormats(var Observer: Codeunit "Probe Observer"; ReportId: Integer)
    begin
        SaveFacts(Observer, 'pdf', ReportId, ReportFormat::Pdf);
        SaveFacts(Observer, 'word', ReportId, ReportFormat::Word);
        SaveFacts(Observer, 'html', ReportId, ReportFormat::Html);
        SaveFacts(Observer, 'xml', ReportId, ReportFormat::Xml);
    end;
}
