// BC Documentation: https://learn.microsoft.com/en-us/dynamics365/business-central/dev-itpro/developer/methods-auto/report/report-saveas-method
// Scope: in-scope
// Fixtures used: Probe Observer (69160); used by the test codeunit 75481; the tables SAE A, SAE B, SAE C and the SAE Helper of SaeFixtures.al
// Facts: the reports and the helper of the statement-form SaveAs probes (al-runner issue 8668; the first probe measured the used form `if Report.SaveAs(...)`).
//   SAE Word Labels: Word layout, two top-level data items (SAE A, SAE B) and a labels section. SAE Word ReqPage: the same with a request page section
//   (one field) instead of labels. SAE Stmt Helper saves with Report.SaveAs as a statement (no return value used) inside a TryFunction and records
//   whether it raised, the error text and code and the stream length.
//   The layout files are generated by the AL compiler (not committed).
// local object: the reports' own layouts and the tables they read are what the tests check.
// BC versions: 27 - 29

report 75480 "SAE Word Labels"
{
    UsageCategory = None;
    UseRequestPage = false;
    DefaultRenderingLayout = SAEWordLabels;

    dataset
    {
        dataitem(A; "SAE A")
        {
            column(AId; Id) { }
        }
        dataitem(B; "SAE B")
        {
            column(BId; Id) { }
        }
    }

    labels
    {
        TitleLbl = 'Title';
        BodyLbl = 'Body';
    }

    rendering
    {
        layout(SAEWordLabels)
        {
            Type = Word;
            LayoutFile = './reports/saveas-empty-items/SAEWordLabels.docx';
        }
    }
}

report 75481 "SAE Word ReqPage"
{
    UsageCategory = None;
    DefaultRenderingLayout = SAEWordReqPage;

    dataset
    {
        dataitem(A; "SAE A")
        {
            column(AId; Id) { }
        }
        dataitem(B; "SAE B")
        {
            column(BId; Id) { }
        }
    }

    requestpage
    {
        layout
        {
            area(Content)
            {
                field(ShowDetails; ShowDetails)
                {
                    ApplicationArea = All;
                }
            }
        }
    }

    rendering
    {
        layout(SAEWordReqPage)
        {
            Type = Word;
            LayoutFile = './reports/saveas-empty-items/SAEWordReqPage.docx';
        }
    }

    var
        ShowDetails: Boolean;
}

codeunit 75480 "SAE Stmt Helper"
{
    [TryFunction]
    local procedure TrySaveStatement(ReportId: Integer; Fmt: ReportFormat; var TempBlob: Codeunit "Temp Blob")
    var
        OutS: OutStream;
    begin
        TempBlob.CreateOutStream(OutS);
        Report.SaveAs(ReportId, '', Fmt, OutS);
    end;

    [TryFunction]
    local procedure TrySaveUsed(ReportId: Integer; Fmt: ReportFormat; var TempBlob: Codeunit "Temp Blob"; var Ok: Boolean)
    var
        OutS: OutStream;
    begin
        TempBlob.CreateOutStream(OutS);
        Ok := Report.SaveAs(ReportId, '', Fmt, OutS);
    end;

    // The first four bytes of the stream as numbers, 'empty' for no byte.
    local procedure FirstBytes(var TempBlob: Codeunit "Temp Blob"): Text
    var
        InS: InStream;
        B: Byte;
        I: Integer;
        Result: Text;
    begin
        if TempBlob.Length() = 0 then
            exit('empty');
        TempBlob.CreateInStream(InS);
        for I := 1 to 4 do
            if not InS.EOS() then begin
                InS.Read(B);
                Result += Format(B) + ',';
            end;
        exit(Result);
    end;

    // Report.SaveAs as a statement: did it complete (Yes: no error was raised), the error, the stream length and its first bytes.
    procedure StatementFacts(var Observer: Codeunit "Probe Observer"; Name: Text; ReportId: Integer; Fmt: ReportFormat)
    var
        TempBlob: Codeunit "Temp Blob";
        Completed: Boolean;
    begin
        ClearLastError();
        Completed := TrySaveStatement(ReportId, Fmt, TempBlob);
        Observer.Observe(Name + ' completed', Format(Completed));
        Observer.ObserveError(Name + ' err');
        Observer.Observe(Name + ' length > 0', Format(TempBlob.Length() > 0));
        Observer.Observe(Name + ' head', FirstBytes(TempBlob));
    end;

    // Report.SaveAs with the return value used: did it complete, what it returned, the error, the stream length and its first bytes.
    procedure UsedFacts(var Observer: Codeunit "Probe Observer"; Name: Text; ReportId: Integer; Fmt: ReportFormat)
    var
        TempBlob: Codeunit "Temp Blob";
        Completed: Boolean;
        Ok: Boolean;
    begin
        ClearLastError();
        Completed := TrySaveUsed(ReportId, Fmt, TempBlob, Ok);
        Observer.Observe(Name + ' completed', Format(Completed));
        Observer.Observe(Name + ' returned', Format(Ok));
        Observer.ObserveError(Name + ' err');
        Observer.Observe(Name + ' length > 0', Format(TempBlob.Length() > 0));
        Observer.Observe(Name + ' head', FirstBytes(TempBlob));
    end;

    procedure StatementAllFormats(var Observer: Codeunit "Probe Observer"; ReportId: Integer)
    begin
        StatementFacts(Observer, 'pdf', ReportId, ReportFormat::Pdf);
        StatementFacts(Observer, 'word', ReportId, ReportFormat::Word);
        StatementFacts(Observer, 'html', ReportId, ReportFormat::Html);
        StatementFacts(Observer, 'xml', ReportId, ReportFormat::Xml);
    end;
}
